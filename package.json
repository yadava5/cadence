{
  "name": "react-calendar-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:vite": "vite",
    "dev:api": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/react_calendar_dev npx tsx scripts/dev-server.ts",
    "dev:vercel": "vercel dev",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:frontend": "vite build",
    "build:backend": "npm run build --workspace=packages/backend",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck:app && npm run typecheck:node && npm run typecheck:api",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "check:serverless": "node scripts/check-serverless-emit.mjs",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "readme:check": "node scripts/readme-facts.mjs --check",
    "readme:write": "node scripts/readme-facts.mjs --write",
    "readme:record": "node scripts/readme-facts.mjs --record",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "test:ui": "vitest --ui",
    "test:backend": "vitest --config vitest.backend.config.ts",
    "test:backend:run": "vitest run --config vitest.backend.config.ts",
    "test:backend:coverage": "vitest run --config vitest.backend.config.ts --coverage",
    "test:frontend": "vitest --config vitest.config.ts",
    "test:frontend:run": "vitest run --config vitest.config.ts",
    "test:all": "npm run test:run --workspaces --if-present && npm run test:frontend:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview",
    "prepare": "husky || exit 0",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "db:seed": "npm run db:seed --workspace=packages/backend",
    "db:studio": "npm run db:studio --workspace=packages/backend"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/rangy": "^1.3.0",
    "@use-gesture/react": "^10.3.1",
    "@vercel/blob": "^0.27.3",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compromise": "^14.16.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.525.0",
    "pdfjs-dist": "^5.4.54",
    "pell": "^1.0.6",
    "pg": "^8.22.0",
    "rangy": "^1.3.2",
    "react": "^19.2.8",
    "react-day-picker": "^9.8.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^3.0.4",
    "react-router-dom": "^7.18.2",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^3.10.1",
    "rrule": "^2.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^11.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "terser": "^5.49.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
